#!/bin/sh
# Blocks any commit whose staged changes contain something that looks like
# an Anthropic API key. The app is designed so keys never belong in code —
# this is a safety net in case that gets violated by accident (e.g. pasting
# a key in for a quick local test and forgetting to remove it).

if git diff --cached | grep -E "sk-ant-[a-zA-Z0-9_-]{10,}" > /dev/null; then
  echo ""
  echo "COMMIT BLOCKED"
  echo "This commit contains what looks like an Anthropic API key (sk-ant-...)."
  echo "Keys belong in the app's Settings panel at runtime, stored in the browser —"
  echo "never in index.html or any committed file."
  echo ""
  echo "Remove the key from your changes, then commit again."
  echo ""
  exit 1
fi

exit 0
